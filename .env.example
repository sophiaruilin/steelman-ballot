# Copy this file to .env (in this steelman-ballot/ folder) and fill in your own keys.
# .env is in .gitignore: never commit real keys.

# LLM: class Portkey key (OpenAI Responses API)
PORTKEY_API_KEY=your-portkey-api-key-here

# One free api.data.gov key covers BOTH OpenFEC and Congress.gov
#   sign up: https://api.data.gov/signup/
DATA_GOV_API_KEY=your-api-data-gov-key-here

# Open States (state legislators, bills, votes)
#   sign up: openstates.org -> API (free account)
OPENSTATES_API_KEY=your-openstates-key-here

# Census Bureau API (American Community Survey: "who's affected" local facts)
#   sign up: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Vote Smart (voting records, public statements, ratings)
#   request: votesmart.org -> Services / API (approval may take days)
VOTESMART_API_KEY=

# Spending guards for the public site
DAILY_TOKEN_CAP=2000000          # all users, all jurisdictions, per day
BALLOT_TOKEN_BUDGET=250000       # one full research run for one jurisdiction

# Optional overrides
MODEL_NAME=gpt-6-astra
PORTKEY_BASE_URL=https://api.portkey.ai/v1
